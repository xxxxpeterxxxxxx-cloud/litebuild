{
	"schemaVersion": 1,
	"id": "litebuild",
	"version": "${version}",
	"name": "LiteBuild",
	"description": "Builds Litematica blueprints step by step using ordinary, rules-compliant player interactions.",
	"authors": ["LiteBuild"],
	"license": "GPL-3.0-or-later",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.litebuild.LiteBuildClient"
		]
	},
	"mixins": [
		"litebuild.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"fabric-api": "*",
		"litematica": ">=0.28.8",
		"malilib": ">=0.29.6",
		"java": ">=25"
	}
}
